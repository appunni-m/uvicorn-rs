      "operation": "python.api.imports-signatures",
      "covers": [
        "python.api.imports-signatures"
      ],
      "api": {
        "imports": [
          "uvicorn.run"
        ],
        "signatures": [
          "uvicorn.run"
        ],
        "calls": [
          {
            "target": "os:environ.pop",
            "arguments": [
              "UVICORN_RS_PARITY_FACTORY_SENTINEL"
