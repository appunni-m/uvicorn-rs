  "operations": [
    {
      "id": "http.scope-and-body",
      "kind": "protocol_operation",
      "observe": [
        "status",
        "content_type",
        "body_bytes"
      ]
    },
    {
      "id": "http.sync-callable-awaitable",
      "kind": "protocol_operation",
      "observe": [
        "status",
        "content_type",
        "body_bytes"
      ]
    },
    {
      "id": "http.response-stream",
      "kind": "protocol_operation",
      "observe": [
        "status",
        "content_type",
        "ordered_body_bytes",
        "connection_closed"
      ]
    },
    {
      "id": "http.response-stream-progress",
      "kind": "protocol_operation",
      "observe": [
        "status",
        "content_type",
        "early_body_bytes",
        "ordered_body_bytes",
        "streamed_before_completion"
      ],
      "required_observations": {
        "streamed_before_completion": true
      }
    },
    {
      "id": "http.response-stream-reset",
      "kind": "protocol_operation",
      "observe": [
        "status",
        "content_type",
        "early_body_bytes",
        "streamed_before_completion",
        "connection_closed",
        "followup_response"
