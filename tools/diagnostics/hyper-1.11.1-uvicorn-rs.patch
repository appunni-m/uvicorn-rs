+/// The order of response header fields to use when encoding a response.
+///
+/// HTTP header maps group values by name and cannot represent interleaved
+/// fields. Attach this extension to a response when the original sequence of
+/// fields must be retained by Hyper's server encoder. Names not present in
+/// this sequence are encoded afterward using the map's normal iteration order.
+#[cfg(all(feature = "server", feature = "http1", not(feature = "http2")))]
+#[derive(Clone, Debug)]
+pub struct HeaderOrder {
+    names: Vec<HeaderName>,
+    overflow_fields: Vec<(HeaderName, http::header::HeaderValue)>,
+}
+
+#[cfg(all(feature = "server", feature = "http1", not(feature = "http2")))]
+impl HeaderOrder {
+    /// Creates an HTTP/1 response header order from header names.
+    ///
+    /// Include a name once for each field with that name. Repeated names retain
+    /// the order of their values in the response's `HeaderMap`.
+    pub fn new(names: impl IntoIterator<Item = HeaderName>) -> Self {
+        Self {
+            names: names.into_iter().collect(),
+            overflow_fields: Vec::new(),
+        }
+    }
+
+    /// Adds fields before the current sequence, such as server-generated
+    /// default headers that precede application headers.
+    pub fn prepend(&mut self, names: impl IntoIterator<Item = HeaderName>) {
+        let mut prefix: Vec<_> = names.into_iter().collect();
+        prefix.append(&mut self.names);
+        self.names = prefix;
+    }
+
+    /// Adds a response field that could not be stored in `http::HeaderMap`.
+    pub fn append_overflow_field(&mut self, name: HeaderName, value: http::header::HeaderValue) {
+        self.overflow_fields.push((name, value));
+    }
+
+    /// Returns response fields kept outside `HeaderMap` after its fixed
+    /// capacity is reached.
+    pub fn overflow_fields(&self) -> &[(HeaderName, http::header::HeaderValue)] {
+        &self.overflow_fields
+    }
+
+    pub(crate) fn names(&self) -> &[HeaderName] {
+        &self.names
+    }
+}
+
+#[cfg(all(feature = "server", feature = "http2"))]
+pub use h2::ext::HeaderOrder;
+
+/// Shared metadata used to preserve an HTTP/2 response's trailer field order.
+///
+/// The response body can finish producing trailers after Hyper has already
+/// sent the response headers. Store this extension on the response and share
+/// a completed `HeaderOrder` with the HTTP/2 body encoder when the trailer
+/// frame is produced.
+#[cfg(feature = "http2")]
+#[doc(hidden)]
+#[derive(Clone, Debug, Default)]
+pub struct ResponseTrailerOrder(std::sync::Arc<std::sync::Mutex<Option<h2::ext::HeaderOrder>>>);
+
+#[cfg(feature = "http2")]
+impl ResponseTrailerOrder {
+    /// Creates an empty shared response trailer order.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Sets the completed order used to encode the response trailer fields.
+    #[doc(hidden)]
+    pub fn set(&self, order: h2::ext::HeaderOrder) {
+        *self
+            .0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) = Some(order);
+    }
+
+    pub(crate) fn take(&self) -> Option<h2::ext::HeaderOrder> {
+        self.0
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+    }
+}
